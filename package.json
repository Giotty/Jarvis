{
  "name": "jarvis", "version": "0.1.0", "private": true,
  "description": "Local-first Windows AI desktop assistant", "author": "JARVIS contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs", "build": "tsc --noEmit && vite build",
    "start": "electron .", "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit", "dist": "pnpm build && electron-builder --win nsis",
    "portable": "pnpm build && electron-builder --win dir"
  },
  "dependencies": {"react": "^19.1.0", "react-dom": "^19.1.0", "systeminformation": "^5.27.0", "sql.js": "^1.13.0", "zod": "^3.24.0"},
  "devDependencies": {"@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "typescript": "^5.8.0", "vite": "^7.0.0", "electron": "^38.0.0", "electron-builder": "^26.0.0"},
  "build": {"appId": "local.jarvis.assistant", "productName": "JARVIS", "directories": {"output": "release"}, "files": ["dist/**", "desktop/**", "core/**", "voice/**", "assets/**", "package.json"], "asarUnpack": ["voice/**"], "win": {"icon": "assets/icon.ico", "target": "nsis"}, "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}}
}
