{
  "name": "jarvis",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first Windows AI desktop assistant",
  "author": "JARVIS contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "lint": "eslint frontend core desktop scripts tests vite.config.ts",
    "format": "prettier --write frontend core desktop scripts tests *.json *.ts *.mjs *.yaml *.md docs",
    "dist": "pnpm build && node scripts/package.cjs",
    "portable": "pnpm build && node scripts/package.cjs --portable"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "cheerio": "1.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "systeminformation": "^5.27.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "voice/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "voice/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
